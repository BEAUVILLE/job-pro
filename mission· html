<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>DIGIY JOBS — Mission</title>
  <meta name="theme-color" content="#071711" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root{
      --bg:#071711;
      --bg2:#0c241b;
      --card:#102a20;
      --line:rgba(255,255,255,.12);
      --text:#ecfff4;
      --muted:rgba(236,255,244,.72);
      --gold:#facc15;
      --gold2:#fde68a;
      --green:#22c55e;
      --max:1080px;
      --shadow:0 18px 60px rgba(0,0,0,.28);
    }
    *{box-sizing:border-box}
    html,body{
      margin:0;padding:0;color:var(--text);
      background:
        radial-gradient(circle at top, rgba(250,204,21,.08), transparent 22%),
        linear-gradient(180deg,var(--bg),#06120d 100%);
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }
    a{color:inherit;text-decoration:none}
    .wrap{max-width:var(--max);margin:0 auto;padding:18px 16px 80px}
    .topbar{
      display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;
    }
    .chip-link{
      display:inline-flex;align-items:center;justify-content:center;
      min-height:44px;padding:10px 14px;border-radius:999px;
      border:1px solid var(--line);background:rgba(255,255,255,.05);font-weight:800;
    }
    .hero{
      border:1px solid var(--line);
      border-radius:30px;
      padding:24px 20px;
      background:
        radial-gradient(circle at 90% 18%, rgba(250,204,21,.15), transparent 18%),
        linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02)),
        var(--bg2);
      box-shadow:var(--shadow);
    }
    .badge-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
    .badge{
      display:inline-flex;align-items:center;
      padding:8px 11px;border-radius:999px;
      font-size:12px;font-weight:900;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.05);
    }
    .badge.gold{
      border-color:rgba(250,204,21,.3);
      background:rgba(250,204,21,.08);
      color:#fff0a9;
    }
    h1{
      margin:0 0 10px;
      font-size:clamp(32px,5vw,56px);
      line-height:1;
      letter-spacing:-.03em;
    }
    .lead{
      color:var(--muted);
      font-size:16px;
      line-height:1.65;
      margin:0;
      max-width:820px;
    }
    .meta-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:12px;
      margin-top:20px;
    }
    .meta-card{
      border:1px solid var(--line);
      border-radius:20px;
      background:rgba(255,255,255,.04);
      padding:15px;
    }
    .meta-label{
      color:var(--muted);
      font-size:12px;
      text-transform:uppercase;
      letter-spacing:.08em;
      font-weight:800;
      margin-bottom:6px;
    }
    .meta-value{
      font-weight:900;
      line-height:1.35;
    }

    .layout{
      display:grid;
      grid-template-columns:1.15fr .85fr;
      gap:18px;
      margin-top:18px;
    }

    .panel{
      border:1px solid var(--line);
      border-radius:28px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.01)),
        var(--card);
      padding:22px 18px;
      box-shadow:var(--shadow);
    }
    .panel h2{
      margin:0 0 12px;
      font-size:22px;
      line-height:1.1;
    }
    .body-text{
      color:var(--muted);
      line-height:1.75;
      white-space:pre-line;
      font-size:15px;
    }
    .good-row{
      display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;
    }
    .good{
      padding:9px 12px;border-radius:999px;
      background:rgba(34,197,94,.1);
      color:#c9ffd4;
      border:1px solid rgba(34,197,94,.2);
      font-weight:900;font-size:13px;
    }

    .cta-box{
      display:flex;
      flex-direction:column;
      gap:12px;
    }
    .cta-btn{
      display:inline-flex;justify-content:center;align-items:center;
      min-height:52px;
      padding:14px 16px;
      border-radius:18px;
      font-weight:900;
      border:none;
      cursor:pointer;
    }
    .cta-primary{
      background:linear-gradient(180deg,var(--gold),#eab308);
      color:#171717;
    }
    .cta-secondary{
      border:1px solid var(--line);
      background:rgba(255,255,255,.06);
      color:var(--text);
    }

    .status{
      border:1px dashed var(--line);
      border-radius:24px;
      padding:24px;
      text-align:center;
      color:var(--muted);
      background:rgba(255,255,255,.03);
    }

    @media (max-width: 920px){
      .meta-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .layout{grid-template-columns:1fr}
    }
    @media (max-width: 640px){
      .wrap{padding:14px 12px 70px}
      .hero{padding:22px 14px}
      .panel{padding:18px 14px}
      .meta-grid{grid-template-columns:1fr}
      h1{font-size:34px}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <a class="chip-link" href="index.html">← Retour au mur</a>
      <a class="chip-link" id="postulerTop" href="postuler.html">Postuler</a>
    </div>

    <div id="loadingBox" class="status">Chargement de la mission...</div>

    <div id="page" style="display:none">
      <section class="hero">
        <div class="badge-row">
          <span id="badgeSector" class="badge gold">Secteur</span>
          <span id="badgeContract" class="badge">Contrat</span>
        </div>
        <h1 id="title">Mission</h1>
        <p id="descriptionLead" class="lead"></p>

        <div class="meta-grid">
          <div class="meta-card">
            <div class="meta-label">Ville</div>
            <div id="metaCity" class="meta-value">—</div>
          </div>
          <div class="meta-card">
            <div class="meta-label">Pays</div>
            <div id="metaCountry" class="meta-value">—</div>
          </div>
          <div class="meta-card">
            <div class="meta-label">Rémunération</div>
            <div id="metaPay" class="meta-value">—</div>
          </div>
          <div class="meta-card">
            <div class="meta-label">Structure</div>
            <div id="metaEmployer" class="meta-value">—</div>
          </div>
        </div>
      </section>

      <section class="layout">
        <div class="panel">
          <h2>Détail de la mission</h2>
          <div id="detailText" class="body-text"></div>

          <h2 style="margin-top:22px;">Exigences</h2>
          <div id="requirementsText" class="body-text"></div>

          <div id="goodRow" class="good-row"></div>
        </div>

        <aside class="panel">
          <h2>Postuler maintenant</h2>
          <div class="body-text" style="margin-bottom:16px;">
            Cette mission est ouverte. Si ton profil colle, envoie ta candidature.
            Le but ici n’est pas de faire joli. Le but, c’est de faire avancer le terrain.
          </div>

          <div class="cta-box">
            <a id="postulerBtn" class="cta-btn cta-primary" href="postuler.html">Je postule à cette mission</a>
            <a class="cta-btn cta-secondary" href="index.html">Voir d'autres missions</a>
          </div>
        </aside>
      </section>
    </div>
  </div>

  <script>
    const SUPABASE_URL = "https://wesqmwjjtsefyjnluosj.supabase.co";
    const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indlc3Ftd2pqdHNlZnlqbmx1b3NqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjUxNzg4ODIsImV4cCI6MjA4MDc1NDg4Mn0.dZfYOc2iL2_wRYL3zExZFsFSBK6AbMeOid2LrIjcTdA";
    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const params = new URLSearchParams(location.search);
    const offerId = params.get('id') || '';

    const $ = (id) => document.getElementById(id);

    function escapeHtml(v=''){
      return String(v)
        .replaceAll('&','&amp;')
        .replaceAll('<','&lt;')
        .replaceAll('>','&gt;')
        .replaceAll('"','&quot;')
        .replaceAll("'","&#039;");
    }

    function labelSector(v=''){
      const map = {
        build:'BTP',
        beauty:'Beauté',
        shop:'Boutique',
        food:'Restauration',
        service:'Services',
        driver:'Chauffeur',
        market:'Marché',
        admin:'Admin'
      };
      return map[v] || v || 'Secteur';
    }

    function labelContract(v=''){
      const map = {
        cdi:'CDI',
        cdd:'CDD',
        mission:'Mission',
        stage:'Stage',
        freelance:'Freelance',
        extra:'Extra'
      };
      return map[v] || v || 'Contrat';
    }

    async function loadOffer(){
      if (!offerId) {
        $('loadingBox').textContent = 'Mission introuvable : identifiant manquant.';
        return;
      }

      const { data, error } = await sb
        .from('digiy_jobs_offers_pro')
        .select('id,workspace_slug,title,sector,city,country,contract_type,pay,description,requirements,has_housing,has_family_welcome,employer_name,contact_phone,status')
        .eq('id', offerId)
        .eq('status', 'active')
        .maybeSingle();

      if (error || !data) {
        console.error(error);
        $('loadingBox').textContent = 'Impossible de charger cette mission.';
        return;
      }

      document.title = `${data.title || 'Mission'} — DIGIY JOBS`;

      $('badgeSector').textContent = labelSector(data.sector);
      $('badgeContract').textContent = labelContract(data.contract_type);
      $('title').textContent = data.title || 'Mission';
      $('descriptionLead').textContent = data.description || 'Description à venir.';
      $('metaCity').textContent = data.city || 'Ville à préciser';
      $('metaCountry').textContent = data.country || 'Sénégal';
      $('metaPay').textContent = data.pay || 'À préciser';
      $('metaEmployer').textContent = data.employer_name || data.workspace_slug || 'Structure à préciser';
      $('detailText').textContent = data.description || 'Description à venir.';
      $('requirementsText').textContent = data.requirements || 'Exigences à préciser.';

      const postulerHref = `postuler.html?offer=${encodeURIComponent(data.id)}`;
      $('postulerBtn').href = postulerHref;
      $('postulerTop').href = postulerHref;

      const goods = [];
      if (data.has_housing) goods.push('<span class="good">Logement possible</span>');
      if (data.has_family_welcome) goods.push('<span class="good">Accueil familial possible</span>');
      if (data.contact_phone) goods.push(`<span class="good">Contact : ${escapeHtml(data.contact_phone)}</span>`);
      $('goodRow').innerHTML = goods.join('');

      $('loadingBox').style.display = 'none';
      $('page').style.display = 'block';
    }

    loadOffer();
  </script>
</body>
</html>
