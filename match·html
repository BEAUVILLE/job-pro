      function safe(value, fallback = "—") {
        return value == null || value === "" ? fallback : String(value);
      }

      function formatDate(value) {
        if (!value) return "—";
        try {
          return new Intl.DateTimeFormat("fr-FR", {
            dateStyle: "medium",
            timeStyle: "short"
          }).format(new Date(value));
        } catch {
          return String(value);
        }
      }

      function normalizeSlug(value = "") {
        return String(value || "")
          .trim()
          .toLowerCase()
          .replace(/\s+/g, "-")
          .replace(/[^a-z0-9-]/g, "")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, "");
      }

      function normalizePhone(value = "") {
        return String(value || "").trim().replace(/[^\d+]/g, "");
      }

      function normalizeText(value = "") {
        return String(value || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/\s+/g, " ")
          .trim();
      }

      function escapeHtml(str = "") {
        return String(str)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function sectorLabel(value = "") {
        return SECTOR_LABELS[String(value || "").toLowerCase()] || safe(value, "Secteur");
      }

      function contractLabel(value = "") {
        return CONTRACT_LABELS[String(value || "").toLowerCase()] || safe(value, "Contrat");
      }

      function sectorClass(value = "") {
        const s = String(value || "").toLowerCase();
        if (s === "build") return "sector-build";
        if (s === "food") return "sector-food";
        if (s === "driver") return "sector-driver";
        return "sector-other";
      }

      function statusLabel(value = "") {
        return STATUS_LABELS[String(value || "").toLowerCase()] || safe(value, "Statut");
      }

      function labelAvailability(value = "") {
        return AVAILABILITY_LABELS[String(value || "").toLowerCase()] || safe(value, "À discuter");
      }

      function availabilityCode(value = "") {
        const v = normalizeText(value);
        if (!v) return "";
        if (v === "immediate" || v.includes("immediat")) return "immediate";
        if (v === "this_week" || v.includes("semaine") || v.includes("48h")) return "this_week";
        if (v === "this_month" || v.includes("mois")) return "this_month";
        if (v === "to_discuss" || v.includes("discut")) return "to_discuss";
        return String(value || "").toLowerCase();
      }

      function tokenize(value = "") {
        const stop = new Set([
          "de","du","des","le","la","les","un","une","et","ou","au","aux","pour","par","avec","sur","dans",
          "mission","poste","profil","candidat","recherche","nous","vous","plus","très","tres","être","etre",
          "savoir","faire","avoir","sera","sont","est","the","and","for"
        ]);
        return normalizeText(value)
          .split(/[^a-z0-9+]+/)
          .filter(Boolean)
          .filter((x) => x.length >= 3)
          .filter((x) => !stop.has(x));
      }

      function nearZone(a, b) {
        const aa = normalizeText(a);
        const bb = normalizeText(b);
        if (!aa || !bb) return false;
        if (aa === bb) return true;
        return (NEAR_ZONES[aa] || []).includes(bb) || (NEAR_ZONES[bb] || []).includes(aa);
      }

      function urgencyLevel(offer) {
        const text = normalizeText([
          offer?.title,
          offer?.description,
          offer?.requirements,
          offer?.published_at
        ].join(" "));
        if (text.includes("urgent") || text.includes("immediat") || text.includes("demain") || text.includes("48h")) return "high";
        return "normal";
      }

