      function withSlug(path, slug) {
        const cleanSlug = normalizeSlug(slug || "");
        if (!cleanSlug) return path;
        const joiner = path.includes("?") ? "&" : "?";
        return `${path}${joiner}slug=${encodeURIComponent(cleanSlug)}`;
      }

