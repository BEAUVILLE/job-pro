        }

        if (!state.mission) {
          state.ranked = [];
          renderStats();
          candidateList.innerHTML = `
            <div class="empty-card">
              <h4>Aucune mission active</h4>
              <p>Publie une mission JOBS PRO, ou ouvre cette page avec un slug et une offre active.</p>
            </div>
          `;
          renderDetail(null);
          return;
        }

        state.ranked = getVisibleRanked();
        renderStats();

        if (!state.ranked.length) {
          candidateList.innerHTML = `
            <div class="empty-card">
              <h4>Aucun candidat trouvé</h4>
              <p>Change les filtres, attends de nouvelles candidatures, ou importe le dernier dossier public si tu en as un.</p>
            </div>
          `;
          renderDetail(null);
          return;
        }

        if (!state.ranked.some((x) => x.candidate.id === state.selectedId)) {
          state.selectedId = state.ranked[0].candidate.id;
        }

        state.ranked.forEach((row) => {
          const c = row.candidate;
          const article = document.createElement("article");
          article.className = "candidate" + (c.id === state.selectedId ? " active" : "");

          article.innerHTML = `
            <div class="candidate-top">
              <div>
                <h4>${escapeHtml(c.full_name || "Sans nom")}</h4>
                <p class="sub">${escapeHtml(safe(c.trade))} • ${escapeHtml(safe(c.city))}</p>
              </div>
              <div class="score-pill">${row.match.score}</div>
            </div>

            <div class="chips">
              <span class="chip ${sectorClass(state.mission?.sector)}">${escapeHtml(sectorLabel(state.mission?.sector))}</span>
              <span class="chip ${scoreClass(row.match.score)}">Score ${row.match.score}</span>
              <span class="chip">${escapeHtml(labelAvailability(c.availability))}</span>
              <span class="chip">${escapeHtml(statusLabel(c.status || "new"))}</span>
              ${row.match.validated ? '<span class="chip score-high">Validé</span>' : ''}
            </div>

            <div class="candidate-note">
              ${escapeHtml((c.message || c.years_experience || row.match.summary || "Profil à lire").slice(0, 170))}
            </div>
          `;

          article.addEventListener("click", function(){
            state.selectedId = c.id;
            renderList();
          });

          candidateList.appendChild(article);
        });

        const current = state.ranked.find((x) => x.candidate.id === state.selectedId) || null;
        renderDetail(current);
      }

      function fieldHtml(label, value, full = false) {
        return `<div class="field${full ? " full" : ""}"><small>${escapeHtml(label)}</small><strong>${escapeHtml(safe(value))}</strong></div>`;
      }

      function buildPublicMissionUrl() {
        if (!state.mission?.id) return "";
        const u = new URL(JOBS_PATHS.mission, location.href);
        u.searchParams.set("id", state.mission.id);
        if (state.workspaceSlug) u.searchParams.set("slug", state.workspaceSlug);
        return u.toString();
      }

      function buildCandidateSheetText(candidate) {
        return [
          `Nom : ${safe(candidate.full_name)}`,
          `WhatsApp : ${safe(candidate.whatsapp_phone)}`,
          `Ville : ${safe(candidate.city)}`,
          `Pays : ${safe(candidate.country)}`,
          `Métier : ${safe(candidate.trade)}`,
          `Expérience : ${safe(candidate.years_experience)}`,
          `Disponibilité : ${labelAvailability(candidate.availability)}`,
          `Statut bureau : ${statusLabel(candidate.status || "new")}`,
          `Message : ${safe(candidate.message)}`,
          state.mission ? `Mission liée : ${safe(state.mission.title)}` : ""
        ].filter(Boolean).join("\n");
      }

      function buildWhatsAppUrl(candidate, score) {
        const lines = [
          "Bonjour,",
          "",
          "je vous contacte depuis DIGIY JOBS concernant une mission qui pourrait vous correspondre.",
          state.mission?.title ? `Mission : ${state.mission.title}` : null,
          state.mission?.employer_name ? `Structure : ${state.mission.employer_name}` : null,
          state.mission?.city ? `Ville : ${state.mission.city}` : null,
          state.mission?.pay ? `Rémunération : ${state.mission.pay}` : null,
          `Compatibilité observée : ${score}/100`,
          buildPublicMissionUrl() ? `Lien mission : ${buildPublicMissionUrl()}` : null,
          "",
          "Si vous êtes partant, on peut avancer sur la mise en relation."
        ].filter(Boolean).join("\n");

        const phone = String(candidate.whatsapp_phone || "").replace(/[^\d]/g, "");
        const url = new URL(`https://wa.me/${phone}`);
        url.searchParams.set("text", lines);
        return url.toString();
      }

      function renderDetail(row) {
        if (!row) {
          emptyState.hidden = false;
          detailContent.hidden = true;
          return;
        }

        const candidate = row.candidate;
        const key = getMatchKey(candidate);
        const saved = state.matchState[key] || {};

        emptyState.hidden = true;
        detailContent.hidden = false;

        detailName.textContent = candidate.full_name || "Sans nom";
        detailSubtitle.textContent = [
          safe(candidate.trade),
          safe(candidate.city),
          labelAvailability(candidate.availability)
        ].join(" • ");

        detailChips.innerHTML = `
          <span class="chip ${sectorClass(state.mission?.sector)}">${escapeHtml(sectorLabel(state.mission?.sector))}</span>
          <span class="chip ${scoreClass(row.match.score)}">Score ${row.match.score}</span>
          <span class="chip">${escapeHtml(statusLabel(candidate.status || "new"))}</span>
          ${row.match.validated ? '<span class="chip score-high">Validé</span>' : ''}
        `;

        matchSummary.textContent = row.match.summary;
        reasonList.innerHTML = row.match.reasons.map((reason) => `<div class="reason-item">${escapeHtml(reason)}</div>`).join("");
        matchNotes.value = saved.notes || "";
        btnOpenWA.href = buildWhatsAppUrl(candidate, row.match.score);

        const detailFields = [
          fieldHtml("Téléphone", candidate.whatsapp_phone),
          fieldHtml("Ville", candidate.city),
          fieldHtml("Pays", candidate.country || "Sénégal"),
          fieldHtml("Métier", candidate.trade),
          fieldHtml("Expérience", candidate.years_experience),
          fieldHtml("Disponibilité", labelAvailability(candidate.availability)),
          fieldHtml("Statut bureau", statusLabel(candidate.status || "new")),
          fieldHtml("Source", candidate.source || "public_form"),
          fieldHtml("Reçu le", formatDate(candidate.created_at)),
          fieldHtml("Mis à jour le", formatDate(candidate.updated_at || candidate.created_at)),
          fieldHtml("Message candidat", candidate.message || "—", true),
          fieldHtml("Mission liée", state.mission?.title || "—", true),
          fieldHtml("Validation", row.match.validated ? "Oui" : "Non"),
          fieldHtml("Validé le", saved.validated_at ? formatDate(saved.validated_at) : "—"),
          fieldHtml("Notes bureau", saved.notes || "—", true)
        ];

        detailGrid.innerHTML = detailFields.join("");
      }

      async function copyText(text) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      }

      async function importPublicDossier() {
        if (state.preview) {
          setStatus("Mode aperçu : active ton accès JOBS pour importer un dossier public.", "warn");
          return;
        }

        if (!sb) {
          setStatus("Supabase non chargé. Vérifie la configuration front.", "error");
          return;
        }

        if (!state.workspaceSlug && !state.mission?.workspace_slug) {
          setStatus("Aucun workspace détecté. Ouvre la page avec ?slug=jobs-... ou via l’entrée PIN.", "warn");
          return;
        }

        const dossier = readJson(PUBLIC_DOSSIER_KEY);
        if (!dossier || !dossier.phone) {
          setStatus("Aucun dernier dossier public intelligent trouvé dans ce navigateur.", "warn");
          return;
        }

        const phone = normalizePhone(dossier.phone);
        const alreadyExists = state.candidates.some((c) => normalizePhone(c.whatsapp_phone) === phone);
        if (alreadyExists) {
          setStatus("Le dernier dossier public semble déjà présent dans le bureau de cette mission.", "info");
          return;
        }

        const payload = {
          offer_id: state.mission?.id || null,
          workspace_slug: state.workspaceSlug || state.mission?.workspace_slug || null,
          full_name: String(dossier.nom || dossier.full_name || "Dossier public").trim(),
          whatsapp_phone: phone,
          city: String(dossier.zone || dossier.city || "").trim() || null,
          country: String(dossier.country || "Sénégal").trim(),
          trade: String(dossier.metier || dossier.buildMetier || dossier.hotelMetier || "").trim() || null,
          years_experience: String(dossier.niveau || dossier.years_experience || "").trim() || null,
          availability: availabilityCode(dossier.dispo || dossier.availability || "") || "to_discuss",
          message: [
            dossier.note || null,
            dossier.bureau_notes || null,
            dossier.link ? `Lien dossier: ${dossier.link}` : null
          ].filter(Boolean).join(" | ") || null,
          status: "new",
          source: "import_public_dossier"
        };

        if (!payload.full_name || !payload.whatsapp_phone) {
          setStatus("Le dossier public trouvé est incomplet : nom ou téléphone manquant.", "warn");
          return;
        }

        const { error } = await sb
          .from("digiy_jobs_candidates_pro")
          .insert(payload);

        if (error) {
          console.error(error);
          setStatus("Impossible d’importer le dossier public dans la base JOBS pour le moment.", "error");
          return;
        }

        await loadCandidates();
        renderList();
        setStatus("Dernier dossier public importé dans le bureau JOBS.", "ok");
      }

      async function bootGuard() {
        if (state.workspaceSlug) {
          state.workspaceSlug = normalizeSlug(state.workspaceSlug);
        }

        if (!window.DIGIY_GUARD || typeof window.DIGIY_GUARD.ready !== "function") {
          state.preview = true;
          miniMode.textContent = "guard manquant";
          syncLinks();
          setStatus("guard.js manquant ou invalide : matching réel verrouillé en aperçu.", "warn");
          return;
        }

        const session = await window.DIGIY_GUARD.ready();
        state.session = session || null;

        const sessionSlug = normalizeSlug(session?.slug || "");
        if (!state.workspaceSlug && sessionSlug) {
          state.workspaceSlug = sessionSlug;
        }

        state.preview = !session?.access;
        miniMode.textContent = state.preview ? "aperçu verrouillé" : "cockpit réel";

        if (state.preview) {
          setStatus("Mode aperçu : active ton accès JOBS pour ouvrir le matching réel et lire les candidatures du bureau.", "warn");
        }

        syncLinks();
      }

      missionSelect.addEventListener("change", async function() {
        const selected = String(missionSelect.value || "");
        state.mission = state.offers.find((offer) => offer.id === selected) || null;
        loadMatchState();
        syncLinks();
        renderMission();
        await loadCandidates();
        renderList();
      });

      searchInput.addEventListener("input", renderList);
      filterZoneMode.addEventListener("change", renderList);
      filterMinScore.addEventListener("change", renderList);
      filterStatus.addEventListener("change", renderList);
      filterAvailability.addEventListener("change", renderList);

      btnReloadMission.addEventListener("click", async function() {
        try {
          await loadMissionRail();
          await loadCandidates();
          renderList();
          setStatus("Mission rechargée depuis le rail JOBS.", "ok");
        } catch (error) {
          console.error(error);
          setStatus("Impossible de recharger la mission pour le moment.", "error");
        }
      });

      btnImportPublic.addEventListener("click", importPublicDossier);

      btnClearFilters.addEventListener("click", function() {
        searchInput.value = "";
        filterZoneMode.value = "all";
        filterMinScore.value = "0";
        filterStatus.value = "all";
        filterAvailability.value = "all";
        renderList();
      });

      btnSaveMatchNotes.addEventListener("click", function() {
        const row = state.ranked.find((x) => x.candidate.id === state.selectedId);
        if (!row) return;
        const key = getMatchKey(row.candidate);
        state.matchState[key] = state.matchState[key] || {};
        state.matchState[key].notes = matchNotes.value.trim();
        saveMatchState();
        renderDetail(row);
        setStatus("Notes de match enregistrées.", "ok");
      });

      btnCopyCandidateLink.addEventListener("click", async function() {
        const row = state.ranked.find((x) => x.candidate.id === state.selectedId);
        if (!row) return;
        const text = buildCandidateSheetText(row.candidate);
        const ok = await copyText(text);
        if (ok) {
          setStatus("Fiche candidat copiée.", "ok");
        } else {
          prompt("Copie la fiche candidat :", text);
        }
      });

      btnCopyMissionLink.addEventListener("click", async function() {
        const url = buildPublicMissionUrl();
        if (!url) return;
        const ok = await copyText(url);
        if (ok) {
          setStatus("Lien mission copié.", "ok");
        } else {
          prompt("Copie le lien mission :", url);
        }
      });

      btnValidateMatch.addEventListener("click", function() {
        const row = state.ranked.find((x) => x.candidate.id === state.selectedId);
        if (!row) return;
        const key = getMatchKey(row.candidate);
        state.matchState[key] = state.matchState[key] || {};
        state.matchState[key].validated = true;
        state.matchState[key].validated_at = new Date().toISOString();
        state.matchState[key].score = row.match.score;
        state.matchState[key].candidate_name = row.candidate.full_name || "Sans nom";
        state.matchState[key].mission_name = state.mission?.title || "Mission";
        state.matchState[key].notes = matchNotes.value.trim();
        saveMatchState();
        renderList();
        setStatus("Match validé localement pour ce workspace.", "ok");
      });

      btnExportMatches.addEventListener("click", function() {
        const rows = state.ranked.map((row) => {
          const key = getMatchKey(row.candidate);
          const saved = state.matchState[key] || {};
          return {
            workspace_slug: state.workspaceSlug || null,
            offer_id: state.mission?.id || null,
            mission: state.mission?.title || "Mission",
            sector: state.mission?.sector || null,
            candidate_name: row.candidate.full_name || "Sans nom",
            candidate_phone: row.candidate.whatsapp_phone || "",
            trade: row.candidate.trade || "",
            city: row.candidate.city || "",
            score: row.match.score,
            summary: row.match.summary,
            reasons: row.match.reasons,
            validated: !!saved.validated,
            validated_at: saved.validated_at || null,
            notes: saved.notes || ""
          };
        });

        const blob = new Blob([JSON.stringify(rows, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "digiy-jobs-matchs.json";
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
      });

      btnResetValidated.addEventListener("click", function() {
        if (!confirm("Vider toutes les validations locales pour ce workspace ?")) return;
        state.matchState = {};
        saveMatchState();
        renderList();
        setStatus("Validations locales vidées.", "ok");
      });

      (async function init() {
        try {
          if (!sb) {
            setStatus("Supabase non chargé. Vérifie la configuration front JOBS.", "error");
            return;
          }

          await bootGuard();
          await loadMissionRail();
          await loadCandidates();
          renderList();

          if (!state.workspaceSlug && !state.mission) {
            setStatus("Aucun slug ni aucune mission détectés. Ouvre la page avec ?slug=jobs-... ou ?id=....", "warn");
          } else if (!state.preview) {
            setStatus("Matching JOBS chargé sur le rail réel.", "ok");
          }
        } catch (error) {
          console.error(error);
          setStatus("Erreur de chargement du matching JOBS. Vérifie le slug, les tables et les policies RLS.", "error");
        }
      })();
    })();
  </script>
</body>
</html>
