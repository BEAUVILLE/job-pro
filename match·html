      async function loadCandidates() {
        if (!sb) throw new Error("Supabase non chargé");
        if (state.preview) {
          state.candidates = [];
          return;
        }

        if (!state.workspaceSlug && !state.mission?.id) {
          state.candidates = [];
          return;
        }

        const seen = new Set();
        const rows = [];

        if (state.workspaceSlug) {
          const { data, error } = await sb
            .from("digiy_jobs_candidates_pro")
            .select("id,offer_id,workspace_slug,full_name,whatsapp_phone,city,country,trade,years_experience,availability,message,status,source,created_at,updated_at")
            .eq("workspace_slug", state.workspaceSlug)
            .order("created_at", { ascending: false });

          if (error) throw error;

          (data || []).forEach((row) => {
            if (!seen.has(row.id)) {
              seen.add(row.id);
              rows.push(row);
            }
          });
        }

        if (state.mission?.id) {
          const { data, error } = await sb
            .from("digiy_jobs_candidates_pro")
            .select("id,offer_id,workspace_slug,full_name,whatsapp_phone,city,country,trade,years_experience,availability,message,status,source,created_at,updated_at")
            .eq("offer_id", state.mission.id)
            .order("created_at", { ascending: false });

          if (error) throw error;

          (data || []).forEach((row) => {
            if (!seen.has(row.id)) {
              seen.add(row.id);
              rows.push(row);
            }
          });
        }

        state.candidates = rows.sort((a, b) => {
          const aa = new Date(a.created_at || 0).getTime();
          const bb = new Date(b.created_at || 0).getTime();
          return bb - aa;
        });
      }

      function keywordHits(text, sector) {
        const keywords = SECTOR_KEYWORDS[String(sector || "").toLowerCase()] || [];
        const norm = normalizeText(text);
        let hits = 0;
        keywords.forEach((kw) => {
          if (norm.includes(normalizeText(kw))) hits += 1;
        });
        return hits;
      }

      function computeScore(candidate) {
        if (!state.mission) {
          return {
            score: 0,
            reasons: ["Aucune mission active."],
            summary: "Pas de matching sans mission.",
            validated: false
          };
        }

        const offer = state.mission;
        const reasons = [];
        let score = 20;

        const offerText = [
          offer.title,
          offer.description,
          offer.requirements,
          offer.city,
          offer.country,
          offer.contract_type,
          offer.pay,
          sectorLabel(offer.sector)
        ].join(" ");

        const candidateText = [
          candidate.full_name,
          candidate.trade,
          candidate.years_experience,
          labelAvailability(candidate.availability),
          candidate.message,
          candidate.city,
          candidate.country,
          candidate.source
        ].join(" ");

        const offerTokens = new Set(tokenize(offerText));
        const candidateTokens = new Set(tokenize(candidateText));
        const overlap = [...candidateTokens].filter((token) => offerTokens.has(token));
        const overlapScore = Math.min(28, overlap.length * 4);

        if (overlapScore > 0) {
          score += overlapScore;
          reasons.push(`Vocabulaire proche entre la mission et le profil (${overlap.length} point(s) d’accroche).`);
        } else {
          reasons.push("Peu de vocabulaire métier commun visible dans le texte.");
        }

        const sectorHits = keywordHits(candidateText, offer.sector);
        if (sectorHits >= 3) {
          score += 14;
          reasons.push("Le profil parle clairement le langage du secteur visé.");
        } else if (sectorHits >= 1) {
          score += 8;
          reasons.push("Le profil montre des signes utiles pour ce secteur.");
        } else {
          reasons.push("Le secteur est à confirmer par lecture humaine.");
        }

        if (normalizeText(candidate.city) && normalizeText(candidate.city) === normalizeText(offer.city)) {
          score += 18;
          reasons.push("Même ville que la mission.");
        } else if (nearZone(candidate.city, offer.city)) {
          score += 10;
          reasons.push("Ville proche de la mission.");
        } else {
          reasons.push("Distance ou mobilité à vérifier.");
        }

        const avail = availabilityCode(candidate.availability);
        const urgency = urgencyLevel(offer);
        if (avail === "immediate" && urgency === "high") {
          score += 12;
          reasons.push("Disponibilité très cohérente avec un besoin urgent.");
        } else if (avail === "immediate" || avail === "this_week") {
          score += 8;
          reasons.push("Disponibilité exploitable rapidement.");
        } else if (avail === "this_month" || avail === "to_discuss") {
          score += 3;
          reasons.push("Disponibilité possible, à cadrer avec le timing réel.");
        } else {
          reasons.push("Disponibilité non claire.");
        }

        const status = String(candidate.status || "new").toLowerCase();
        if (status === "shortlist") {
          score += 12;
          reasons.push("Déjà shortlisté par le bureau.");
        } else if (status === "call") {
          score += 10;
          reasons.push("Déjà prêt pour un rappel.");
        } else if (status === "review") {
          score += 6;
          reasons.push("Déjà en revue dans le bureau.");
        } else if (status === "accepted") {
          score += 2;
          reasons.push("Profil déjà accepté auparavant, à vérifier selon disponibilité réelle.");
        } else if (status === "rejected") {
          score -= 20;
          reasons.push("Profil déjà rejeté dans le rail actuel.");
        }

        if ((candidate.message || "").trim().length >= 50) {
          score += 4;
          reasons.push("Le message candidat donne de la matière pour décider.");
        }

        if ((candidate.years_experience || "").trim().length >= 4) {
          score += 4;
          reasons.push("Un niveau d’expérience est renseigné.");
        }

        score = Math.max(0, Math.min(100, score));

        let summary = "Match à lire calmement.";
        if (score >= 80) {
          summary = "Très bon match potentiel : mission et profil se parlent clairement.";
        } else if (score >= 60) {
          summary = "Match crédible : quelques vérifications peuvent suffire avant action.";
        } else {
          summary = "Match faible ou incomplet : utile surtout en secours ou pour une lecture plus fine.";
        }

        const matchKey = getMatchKey(candidate);
        const validated = Boolean(state.matchState[matchKey]?.validated);

        return { score, reasons, summary, validated };
      }

      function getVisibleRanked() {
        const query = normalizeText(searchInput.value || "");
        const zoneMode = filterZoneMode.value;
        const minScore = Number(filterMinScore.value || 0);
        const wantedStatus = filterStatus.value;
        const wantedAvailability = filterAvailability.value;

        return state.candidates
          .map((candidate) => ({ candidate, match: computeScore(candidate) }))
          .filter((row) => {
            if (!state.mission) return false;

            if (zoneMode === "same" && normalizeText(row.candidate.city) !== normalizeText(state.mission.city)) {
              return false;
            }

            if (
              zoneMode === "near" &&
              normalizeText(row.candidate.city) !== normalizeText(state.mission.city) &&
              !nearZone(row.candidate.city, state.mission.city)
            ) {
              return false;
            }

            if (row.match.score < minScore) return false;
            if (wantedStatus !== "all" && String(row.candidate.status || "new").toLowerCase() !== wantedStatus) return false;
            if (wantedAvailability !== "all" && availabilityCode(row.candidate.availability) !== wantedAvailability) return false;

            if (!query) return true;

            const hay = normalizeText([
              row.candidate.full_name,
              row.candidate.trade,
              row.candidate.city,
              row.candidate.country,
              row.candidate.years_experience,
              row.candidate.message,
              row.candidate.source,
              state.mission?.title,
              state.mission?.description,
              state.mission?.requirements
            ].join(" "));

            return hay.includes(query);
          })
          .sort((a, b) => {
            if (b.match.score !== a.match.score) return b.match.score - a.match.score;
            const aa = new Date(a.candidate.created_at || 0).getTime();
            const bb = new Date(b.candidate.created_at || 0).getTime();
            return bb - aa;
          });
      }

      function renderStats() {
        statCandidates.textContent = String(state.ranked.length);
        statStrong.textContent = String(state.ranked.filter((x) => x.match.score >= 80).length);
        statMedium.textContent = String(state.ranked.filter((x) => x.match.score >= 60 && x.match.score < 80).length);
        statValidated.textContent = String(Object.values(state.matchState).filter((x) => x && x.validated).length);
      }

