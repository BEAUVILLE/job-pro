<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DIGIY JOBS PRO — Fiche mission</title>
  <meta name="description" content="DIGIY JOBS PRO — fiche mission intelligente selon le rail : BUILD ou Hôtellerie-Restauration. Besoin, zone, démarrage, durée, profils recherchés, hébergement éventuel et mise en relation claire." />
  <meta name="theme-color" content="#0A1128" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root{
      --dark:#0A1128;
      --dark-2:#142041;
      --blue:#0ea5e9;
      --blue-2:#38bdf8;
      --green:#10b981;
      --gold:#d4a84f;
      --bg:#edf3f8;
      --sand:#f8f0e3;
      --card:#ffffff;
      --ink:#0f172a;
      --muted:#475569;
      --line:#e2e8f0;
      --shadow:0 16px 42px rgba(15,23,42,.10);
      --radius:22px;
      --radius-sm:16px;
      --max:1080px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:'Poppins',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
      color:var(--ink);
      background:
        radial-gradient(circle at top left, rgba(14,165,233,.08), transparent 28%),
        radial-gradient(circle at right 12%, rgba(16,185,129,.06), transparent 24%),
        linear-gradient(180deg,var(--bg),var(--sand));
    }
    .wrap{width:min(calc(100% - 28px), var(--max));margin:0 auto;padding:20px 0 56px}
    .hero,.card,.guide-card,.rail-box,.sector-panel,.out{
      border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);
    }
    .hero{
      padding:26px 20px;position:relative;overflow:hidden;
      background:linear-gradient(135deg, rgba(10,17,40,.98), rgba(20,32,65,.95));
      color:#fff;
    }
    .hero::before{
      content:"🎯";position:absolute;right:-14px;top:-18px;font-size:120px;opacity:.08;transform:rotate(10deg);
    }
    .eyebrow{
      display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border-radius:999px;
      background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);
      font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;
    }
    h1{margin:14px 0 10px;font-size:clamp(2rem,4vw,3.5rem);line-height:1.04}
    .hero p{margin:0;max-width:820px;color:#dbe7f7;line-height:1.7}
    .hero-tags{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
    .hero-tags span{
      padding:10px 12px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.10);font-size:.92rem;font-weight:700;color:#eef4ff;
    }

    .card{padding:18px;margin-top:14px}
    .pill{
      display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border-radius:999px;background:var(--dark);color:#fff;font-weight:900;font-size:.85rem;
    }
    .guide{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
    @media(max-width:760px){.guide{grid-template-columns:1fr}}
    .guide-card{padding:14px;border-radius:18px;background:#fafcff;box-shadow:none}
    .guide-card strong{display:block;margin-bottom:6px}
    .guide-card span{display:block;color:var(--muted);font-size:.93rem;line-height:1.58}

    .rail-switch{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
    @media(max-width:760px){.rail-switch{grid-template-columns:1fr}}
    .rail-box{
      padding:16px;border-radius:18px;background:#fbfdff;cursor:pointer;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease;
      text-align:left;
    }
    .rail-box:hover{transform:translateY(-1px)}
    .rail-box.active{border-color:var(--blue);box-shadow:0 0 0 4px rgba(14,165,233,.12)}
    .rail-box strong{display:block;font-size:1rem;margin-bottom:6px}
    .rail-box span{display:block;color:var(--muted);font-size:.93rem;line-height:1.55}

    .section-title{margin:0 0 10px;font-size:1.12rem;font-weight:900;letter-spacing:-.01em}
    .section-sub{margin:0 0 14px;color:var(--muted);line-height:1.6}

    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
    @media(max-width:860px){.grid-3{grid-template-columns:1fr}}
    @media(max-width:720px){.grid-2{grid-template-columns:1fr}}

    label{display:block;font-weight:800;font-size:.95rem;margin:0 0 6px}
    input,select,textarea{
      width:100%;padding:12px 12px;border-radius:14px;border:1px solid #d1d5db;background:#fff;color:var(--ink);outline:none;font:inherit;
    }
    textarea{min-height:115px;resize:vertical}
    input:focus,select:focus,textarea:focus{border-color:var(--blue);box-shadow:0 0 0 4px rgba(14,165,233,.15)}
    .hint{color:var(--muted);font-size:.92rem;line-height:1.55;margin-top:7px}
    .hidden{display:none !important}

    .sector-panel{
      padding:16px;border-radius:20px;background:#fbfdff;box-shadow:none;border-style:dashed;margin-top:14px;
    }
    .sector-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px}
    .sector-chip{
      display:inline-flex;align-items:center;gap:8px;padding:8px 10px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:.82rem;font-weight:900;
    }

    .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
    .btn{
      border:0;border-radius:14px;padding:12px 14px;font-weight:900;font-size:1rem;
      cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:10px;
      transition:transform .16s ease, filter .16s ease;
    }
    .btn:hover{transform:translateY(-1px);filter:brightness(.98)}
    .btn.primary{background:linear-gradient(135deg,var(--blue),var(--blue-2));color:#fff}
    .btn.green{background:var(--green);color:#fff}
    .btn.ghost{background:#f1f5f9;color:var(--dark);border:1px solid #cbd5e1}

    .out{padding:14px;border-radius:16px;background:#f9fbfd;border-style:dashed;box-shadow:none;margin-top:14px}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.92rem;word-break:break-all}
    .tiny{font-size:.86rem;color:#64748b;line-height:1.65;margin-top:10px}
  </style>
</head>
<body>
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">DIGIY JOBS PRO • Fiche mission</span>
      <h1>Un besoin cadré vaut mieux qu’un recrutement flou.</h1>
      <p>
        Cette fiche sert à poser une mission réelle avant de matcher. On choisit le rail,
        on décrit le besoin, la zone, le démarrage, la durée, le nombre de profils,
        puis on déclenche une mise en relation propre avec les bons candidats.
      </p>
      <div class="hero-tags">
        <span>BUILD</span>
        <span>Hôtellerie-Restauration</span>
        <span>Socle commun</span>
        <span>Mise en relation claire</span>
      </div>
    </section>

    <section class="card">
      <div class="pill">✅ La fiche s’adapte automatiquement si l’URL contient ?secteur=build ou ?secteur=hotellerie-restauration</div>

      <div class="guide">
        <div class="guide-card">
          <strong>Pourquoi cette fiche existe</strong>
          <span>Pour éviter les besoins flous. Le bureau comprend mieux la mission, filtre mieux, et met en relation plus juste.</span>
        </div>
        <div class="guide-card">
          <strong>Esprit du module</strong>
          <span>Simple, mobile, utile. Pas de roman. Juste les vraies infos qui permettent d’agir.</span>
        </div>
      </div>

      <div class="rail-switch" id="railSwitch">
        <button type="button" class="rail-box" data-secteur="build">
          <strong>🧱 BUILD</strong>
          <span>Chantiers, dépannage, renfort d’équipe, installation, finition, intervention terrain.</span>
        </button>
        <button type="button" class="rail-box" data-secteur="hotellerie-restauration">
          <strong>🍽️ Hôtellerie-Restauration</strong>
          <span>Salle, cuisine, chambre, accueil, entretien, polyvalence, service.</span>
        </button>
      </div>
    </section>

    <section class="card">
      <h2 class="section-title">Socle commun de la mission</h2>
      <p class="section-sub">La base qui doit toujours être claire, quel que soit le rail.</p>

      <div class="grid-2">
        <div>
          <label for="missionName">Nom de la mission</label>
          <input id="missionName" placeholder="Ex. Renfort villa Saly / Service soir restaurant plage" />
          <div class="hint">Un nom simple pour reconnaître vite le besoin.</div>
        </div>
        <div>
          <label for="role">Je suis</label>
          <select id="role">
            <option value="recruteur">🏢 Recruteur / établissement / chantier</option>
            <option value="bureau">🧭 Bureau DIGIY JOBS</option>
          </select>
          <div class="hint">La fiche peut venir du client direct ou du bureau.</div>
        </div>
      </div>

      <div class="grid-2" style="margin-top:12px">
        <div>
          <label for="contactName">Nom du contact</label>
          <input id="contactName" placeholder="Ex. Maison d’hôtes Somone / Chantier Ngaparou" autocomplete="organization" />
          <div class="hint">Nom du lieu, du responsable ou du repère principal.</div>
        </div>
        <div>
          <label for="phone">WhatsApp / téléphone</label>
          <input id="phone" placeholder="+22177xxxxxxx" inputmode="tel" autocomplete="tel" />
          <div class="hint">Indispensable pour aller vite sur la mise en relation.</div>
        </div>
      </div>

      <div class="grid-3" style="margin-top:12px">
        <div>
          <label for="zone">Zone</label>
          <select id="zone">
            <option value="Dakar">Dakar</option>
            <option value="Rufisque">Rufisque</option>
            <option value="Thiès">Thiès</option>
            <option value="Mbour">Mbour</option>
            <option value="Saly">Saly</option>
            <option value="Ngaparou">Ngaparou</option>
            <option value="Somone">Somone</option>
            <option value="Autre">Autre</option>
          </select>
          <div class="hint">Où la mission se déroule.</div>
        </div>
        <div>
          <label for="startDate">Démarrage souhaité</label>
          <select id="startDate">
            <option value="Immédiat">Immédiat</option>
            <option value="Sous 48h">Sous 48h</option>
            <option value="Cette semaine">Cette semaine</option>
            <option value="Date à confirmer">Date à confirmer</option>
          </select>
          <div class="hint">Un repère net pour le bureau.</div>
        </div>
        <div>
          <label for="duration">Durée estimée</label>
          <select id="duration">
            <option value="Ponctuelle">Ponctuelle</option>
            <option value="Quelques jours">Quelques jours</option>
            <option value="1 à 4 semaines">1 à 4 semaines</option>
            <option value="Longue / récurrente">Longue / récurrente</option>
          </select>
          <div class="hint">Aide à filtrer les profils sérieux.</div>
        </div>
      </div>

      <div class="grid-3" style="margin-top:12px">
        <div>
          <label for="countNeeded">Nombre de profils recherchés</label>
          <select id="countNeeded">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4+">4+</option>
          </select>
          <div class="hint">Très utile côté matching.</div>
        </div>
        <div>
          <label for="priority">Priorité</label>
          <select id="priority">
            <option value="Normale">Normale</option>
            <option value="Haute">Haute</option>
            <option value="Urgente">Urgente</option>
          </select>
          <div class="hint">Pour savoir si on pousse la recherche.</div>
        </div>
        <div>
          <label for="housing">Hébergement éventuel</label>
          <select id="housing">
            <option value="Non">Non</option>
            <option value="Possible">Possible</option>
            <option value="Possible si mission longue">Possible si mission longue</option>
            <option value="À confirmer">À confirmer</option>
          </select>
          <div class="hint">Ça change beaucoup la faisabilité.</div>
        </div>
      </div>
    </section>

    <section class="card">
      <div id="buildPanel" class="sector-panel hidden">
        <div class="sector-head">
          <div>
            <h2 class="section-title">Mission BUILD</h2>
            <p class="section-sub">On précise le besoin chantier : métier, mission, niveau, mobilité, cadre terrain.</p>
          </div>
          <span class="sector-chip">🧱 Rail BUILD</span>
        </div>

        <div class="grid-2">
          <div>
            <label for="buildMetier">Métier recherché</label>
            <select id="buildMetier">
              <option value="Maçon">Maçon</option>
              <option value="Plombier">Plombier</option>
              <option value="Électricien">Électricien</option>
              <option value="Soudeur métal / aluminium">Soudeur métal / aluminium</option>
              <option value="Menuisier bois">Menuisier bois</option>
              <option value="Peintre / finition">Peintre / finition</option>
              <option value="Carreleur">Carreleur</option>
              <option value="Manoeuvre">Manoeuvre</option>
              <option value="Autre métier BUILD">Autre métier BUILD</option>
            </select>
            <div class="hint">Le coeur du besoin.</div>
          </div>
          <div>
            <label for="buildMissionType">Type de mission</label>
            <select id="buildMissionType">
              <option value="Chantier complet">Chantier complet</option>
              <option value="Intervention ponctuelle">Intervention ponctuelle</option>
              <option value="Dépannage">Dépannage</option>
              <option value="Finition">Finition</option>
              <option value="Renfort d’équipe">Renfort d’équipe</option>
            </select>
            <div class="hint">Pour qualifier vite la nature du besoin.</div>
          </div>
        </div>

        <div class="grid-3" style="margin-top:12px">
          <div>
            <label for="buildLevel">Niveau attendu</label>
            <select id="buildLevel">
              <option value="Débutant accepté">Débutant accepté</option>
              <option value="Intermédiaire">Intermédiaire</option>
              <option value="Confirmé">Confirmé</option>
              <option value="Chef d’équipe">Chef d’équipe</option>
            </select>
            <div class="hint">Ajuste le tri sans perdre du temps.</div>
          </div>
          <div>
            <label for="buildMobility">Mobilité souhaitée</label>
            <select id="buildMobility">
              <option value="Zone locale">Zone locale</option>
              <option value="Déplacement possible">Déplacement possible</option>
              <option value="Déplacement + mission longue">Déplacement + mission longue</option>
            </select>
            <div class="hint">Important quand le chantier bouge.</div>
          </div>
          <div>
            <label for="buildCadre">Cadre de travail</label>
            <select id="buildCadre">
              <option value="Petite équipe">Petite équipe</option>
              <option value="Équipe structurée">Équipe structurée</option>
              <option value="Travail en autonomie">Travail en autonomie</option>
            </select>
            <div class="hint">Ça aide à éviter les mauvais matchs.</div>
          </div>
        </div>

        <div style="margin-top:12px">
          <label for="buildSpecialite">Précision technique</label>
          <input id="buildSpecialite" placeholder="Ex. dalles, cloisons, tableaux, portails, sanitaire, peinture finale..." />
          <div class="hint">Une ligne technique qui fait gagner du temps à tout le monde.</div>
        </div>
      </div>

      <div id="hotelPanel" class="sector-panel hidden">
        <div class="sector-head">
          <div>
            <h2 class="section-title">Mission Hôtellerie-Restauration</h2>
            <p class="section-sub">On précise service, rythme, horaires, relation client, et cadre d’exploitation.</p>
          </div>
          <span class="sector-chip">🍽️ Hôtellerie-Restauration</span>
        </div>

        <div class="grid-2">
          <div>
            <label for="hotelMetier">Profil recherché</label>
            <select id="hotelMetier">
              <option value="Serveur / Serveuse">Serveur / Serveuse</option>
              <option value="Cuisinier / Cuisinière">Cuisinier / Cuisinière</option>
              <option value="Commis de cuisine">Commis de cuisine</option>
              <option value="Plonge">Plonge</option>
              <option value="Réception / Accueil">Réception / Accueil</option>
              <option value="Femme de chambre / Valet">Femme de chambre / Valet</option>
              <option value="Entretien">Entretien</option>
              <option value="Polyvalent(e)">Polyvalent(e)</option>
            </select>
            <div class="hint">Le profil attendu à l’entrée.</div>
          </div>
          <div>
            <label for="hotelService">Service principal</label>
            <select id="hotelService">
              <option value="Salle">Salle</option>
              <option value="Cuisine">Cuisine</option>
              <option value="Chambre">Chambre</option>
              <option value="Accueil">Accueil</option>
              <option value="Entretien">Entretien</option>
              <option value="Polyvalent">Polyvalent</option>
            </select>
            <div class="hint">Pour ne pas mélanger les mondes.</div>
          </div>
        </div>

        <div class="grid-3" style="margin-top:12px">
          <div>
            <label for="hotelSchedule">Horaires attendus</label>
            <select id="hotelSchedule">
              <option value="Journée">Journée</option>
              <option value="Soir">Soir</option>
              <option value="Coupure">Coupure</option>
              <option value="Nuit">Nuit</option>
              <option value="Flexible">Flexible</option>
            </select>
            <div class="hint">Très utile pour le tri réel.</div>
          </div>
          <div>
            <label for="hotelContactLevel">Relation client attendue</label>
            <select id="hotelContactLevel">
              <option value="Correcte">Correcte</option>
              <option value="Bonne">Bonne</option>
              <option value="Très bonne">Très bonne</option>
            </select>
            <div class="hint">Particulièrement important pour salle et accueil.</div>
          </div>
          <div>
            <label for="hotelRhythm">Rythme de service</label>
            <select id="hotelRhythm">
              <option value="Calme à modéré">Calme à modéré</option>
              <option value="Soutenu">Soutenu</option>
              <option value="Très soutenu">Très soutenu</option>
            </select>
            <div class="hint">Pour ne pas envoyer un profil dans le mauvais feu.</div>
          </div>
        </div>

        <div style="margin-top:12px">
          <label for="hotelCadre">Cadre d’exploitation</label>
          <input id="hotelCadre" placeholder="Ex. restaurant plage, maison d’hôtes, hôtel, snack, service soir..." />
          <div class="hint">Un repère très utile pour cadrer le ton du service attendu.</div>
        </div>
      </div>

      <div style="margin-top:14px">
        <label for="missionNote">Description utile de la mission</label>
        <textarea id="missionNote" placeholder="Ex. Besoin d’un profil sérieux, joignable vite, avec vraie tenue de terrain. Démarrage rapide. Mission claire. Bonne réactivité souhaitée."></textarea>
        <div class="hint">Le bon texte est court, précis, actionnable.</div>
      </div>

      <div class="actions">
        <button class="btn primary" id="btnCreate" type="button">🎯 Créer la fiche mission</button>
        <a class="btn ghost" id="btnCopy" href="#" role="button" aria-disabled="true">📋 Copier le lien</a>
        <a class="btn green" id="btnWhatsApp" href="#" role="button" aria-disabled="true">💬 Ouvrir WhatsApp</a>
      </div>

      <div class="out hidden" id="outBox">
        <div><strong>✅ Fiche mission créée :</strong> <span class="mono" id="slugOut"></span></div>
        <div style="margin-top:8px"><strong>Lien :</strong> <span class="mono" id="linkOut"></span></div>
        <div class="tiny">Le lien peut être repris par le bureau JOBS PRO pour matcher plus proprement avec les bons dossiers.</div>
      </div>

      <div class="tiny">
        DIGIY JOBS PRO ne promet pas un recrutement automatique. Cette fiche sert à cadrer un besoin réel,
        à clarifier la mission, puis à lancer une mise en relation plus juste.
      </div>
    </section>
  </div>

  <script>
    (function(){
      "use strict";

      const WA_DIGIY = "https://wa.me/221771342889";
      const PUBLIC_PAGE = "./mission.html";
      const LS_KEY = "DIGIY_JOBS_PRO_MISSION_V1";
      const params = new URLSearchParams(location.search);
      const secteurParam = (params.get("secteur") || "").toLowerCase();

      const railBoxes = Array.from(document.querySelectorAll(".rail-box"));
      const buildPanel = document.getElementById("buildPanel");
      const hotelPanel = document.getElementById("hotelPanel");

      const missionNameEl = document.getElementById("missionName");
      const roleEl = document.getElementById("role");
      const contactNameEl = document.getElementById("contactName");
      const phoneEl = document.getElementById("phone");
      const zoneEl = document.getElementById("zone");
      const startDateEl = document.getElementById("startDate");
      const durationEl = document.getElementById("duration");
      const countNeededEl = document.getElementById("countNeeded");
      const priorityEl = document.getElementById("priority");
      const housingEl = document.getElementById("housing");
      const missionNoteEl = document.getElementById("missionNote");

      const buildMetierEl = document.getElementById("buildMetier");
      const buildMissionTypeEl = document.getElementById("buildMissionType");
      const buildLevelEl = document.getElementById("buildLevel");
      const buildMobilityEl = document.getElementById("buildMobility");
      const buildCadreEl = document.getElementById("buildCadre");
      const buildSpecialiteEl = document.getElementById("buildSpecialite");

      const hotelMetierEl = document.getElementById("hotelMetier");
      const hotelServiceEl = document.getElementById("hotelService");
      const hotelScheduleEl = document.getElementById("hotelSchedule");
      const hotelContactLevelEl = document.getElementById("hotelContactLevel");
      const hotelRhythmEl = document.getElementById("hotelRhythm");
      const hotelCadreEl = document.getElementById("hotelCadre");

      const btnCreate = document.getElementById("btnCreate");
      const btnCopy = document.getElementById("btnCopy");
      const btnWhatsApp = document.getElementById("btnWhatsApp");
      const outBox = document.getElementById("outBox");
      const slugOut = document.getElementById("slugOut");
      const linkOut = document.getElementById("linkOut");

      let currentSecteur = "build";
      let last = null;

      function normalizePhone(raw){
        if(!raw) return "";
        let p = String(raw).trim().replace(/[\s\-.]/g, "");
        if(p.startsWith("00")) p = "+" + p.slice(2);
        if(/^221\d+/.test(p)) p = "+" + p;
        return p;
      }

      function slugify(s){
        return (s || "")
          .toLowerCase()
          .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 64);
      }

      function shortRand(){
        return Math.random().toString(36).slice(2, 8);
      }

      function setEnabled(a, on){
        if(!a) return;
        a.setAttribute("aria-disabled", on ? "false" : "true");
        a.style.pointerEvents = on ? "auto" : "none";
        a.style.opacity = on ? "1" : ".55";
      }

      function applySecteur(secteur){
        currentSecteur = (secteur === "hotellerie-restauration") ? "hotellerie-restauration" : "build";
        railBoxes.forEach(box => box.classList.toggle("active", box.dataset.secteur === currentSecteur));
        buildPanel.classList.toggle("hidden", currentSecteur !== "build");
        hotelPanel.classList.toggle("hidden", currentSecteur !== "hotellerie-restauration");
      }

      function getMainMetier(){
        return currentSecteur === "build" ? buildMetierEl.value : hotelMetierEl.value;
      }

      function buildSlug(mainMetier, zone){
        return [
          "mission",
          slugify(currentSecteur),
          slugify(mainMetier || "profil"),
          slugify(zone || "zone"),
          shortRand()
        ].filter(Boolean).join("-");
      }

      function buildLink(slug){
        const u = new URL(PUBLIC_PAGE, location.href);
        u.searchParams.set("mission", slug);
        u.searchParams.set("secteur", currentSecteur);
        return u.toString();
      }

      function waUrl(base, msg){
        try{
          const u = new URL(base);
          u.searchParams.set("text", msg);
          return u.toString();
        }catch(e){
          return base + "?text=" + encodeURIComponent(msg);
        }
      }

      function buildMessage(data){
        const lines = [
          "🎯 DIGIY JOBS PRO — Nouvelle fiche mission",
          "Secteur: " + (data.secteur === "build" ? "BUILD" : "Hôtellerie-Restauration"),
          "Mission: " + data.missionName,
          "Émetteur: " + (data.role === "bureau" ? "Bureau DIGIY JOBS" : "Recruteur / établissement / chantier"),
          data.contactName ? ("Contact: " + data.contactName) : null,
          "Téléphone: " + data.phone,
          "Zone: " + data.zone,
          "Démarrage: " + data.startDate,
          "Durée: " + data.duration,
          "Profils recherchés: " + data.countNeeded,
          "Priorité: " + data.priority,
          "Hébergement éventuel: " + data.housing,
          "Profil principal: " + data.mainMetier
        ];

        if(data.secteur === "build"){
          lines.push(
            "Type de mission: " + data.buildMissionType,
            "Niveau attendu: " + data.buildLevel,
            "Mobilité souhaitée: " + data.buildMobility,
            "Cadre de travail: " + data.buildCadre,
            data.buildSpecialite ? ("Précision technique: " + data.buildSpecialite) : null
          );
        } else {
          lines.push(
            "Service principal: " + data.hotelService,
            "Horaires attendus: " + data.hotelSchedule,
            "Relation client attendue: " + data.hotelContactLevel,
            "Rythme de service: " + data.hotelRhythm,
            data.hotelCadre ? ("Cadre d’exploitation: " + data.hotelCadre) : null
          );
        }

        lines.push(
          data.missionNote ? ("Description utile: " + data.missionNote) : null,
          "Lien mission: " + data.link,
          "",
          "Je veux cadrer puis matcher cette mission proprement."
        );

        return lines.filter(Boolean).join("\n");
      }

      railBoxes.forEach(box => {
        box.addEventListener("click", function(){
          applySecteur(box.dataset.secteur);
        });
      });

      try{
        const saved = JSON.parse(localStorage.getItem(LS_KEY) || "null");
        if(saved && saved.slug && saved.link){
          last = saved;
          applySecteur(saved.secteur || "build");
          missionNameEl.value = saved.missionName || "";
          roleEl.value = saved.role || "recruteur";
          contactNameEl.value = saved.contactName || "";
          phoneEl.value = saved.phone || "";
          zoneEl.value = saved.zone || "Saly";
          startDateEl.value = saved.startDate || "Immédiat";
          durationEl.value = saved.duration || "Ponctuelle";
          countNeededEl.value = saved.countNeeded || "1";
          priorityEl.value = saved.priority || "Normale";
          housingEl.value = saved.housing || "Non";
          missionNoteEl.value = saved.missionNote || "";

          if(saved.buildMetier) buildMetierEl.value = saved.buildMetier;
          if(saved.buildMissionType) buildMissionTypeEl.value = saved.buildMissionType;
          if(saved.buildLevel) buildLevelEl.value = saved.buildLevel;
          if(saved.buildMobility) buildMobilityEl.value = saved.buildMobility;
          if(saved.buildCadre) buildCadreEl.value = saved.buildCadre;
          if(saved.buildSpecialite) buildSpecialiteEl.value = saved.buildSpecialite;

          if(saved.hotelMetier) hotelMetierEl.value = saved.hotelMetier;
          if(saved.hotelService) hotelServiceEl.value = saved.hotelService;
          if(saved.hotelSchedule) hotelScheduleEl.value = saved.hotelSchedule;
          if(saved.hotelContactLevel) hotelContactLevelEl.value = saved.hotelContactLevel;
          if(saved.hotelRhythm) hotelRhythmEl.value = saved.hotelRhythm;
          if(saved.hotelCadre) hotelCadreEl.value = saved.hotelCadre;

          outBox.classList.remove("hidden");
          slugOut.textContent = saved.slug;
          linkOut.textContent = saved.link;
          btnCopy.href = saved.link;
          btnWhatsApp.href = saved.wa || "#";
          setEnabled(btnCopy, true);
          setEnabled(btnWhatsApp, true);
        } else {
          applySecteur(secteurParam || "build");
        }
      } catch(e){
        applySecteur(secteurParam || "build");
      }

      btnCreate.addEventListener("click", function(){
        const missionName = (missionNameEl.value || "").trim();
        const role = roleEl.value;
        const contactName = (contactNameEl.value || "").trim();
        const phone = normalizePhone(phoneEl.value);
        const zone = zoneEl.value;
        const startDate = startDateEl.value;
        const duration = durationEl.value;
        const countNeeded = countNeededEl.value;
        const priority = priorityEl.value;
        const housing = housingEl.value;
        const missionNote = (missionNoteEl.value || "").trim();
        const mainMetier = getMainMetier();

        if(!missionName){
          alert("Donne un nom à la mission pour cadrer le besoin.");
          missionNameEl.focus();
          return;
        }
        if(!phone){
          alert("Mets un numéro WhatsApp / téléphone valide avec indicatif.");
          phoneEl.focus();
          return;
        }

        const slug = buildSlug(mainMetier, zone);
        const link = buildLink(slug);

        const data = {
          secteur: currentSecteur,
          missionName,
          role,
          contactName,
          phone,
          zone,
          startDate,
          duration,
          countNeeded,
          priority,
          housing,
          missionNote,
          mainMetier,
          buildMetier: buildMetierEl.value,
          buildMissionType: buildMissionTypeEl.value,
          buildLevel: buildLevelEl.value,
          buildMobility: buildMobilityEl.value,
          buildCadre: buildCadreEl.value,
          buildSpecialite: (buildSpecialiteEl.value || "").trim(),
          hotelMetier: hotelMetierEl.value,
          hotelService: hotelServiceEl.value,
          hotelSchedule: hotelScheduleEl.value,
          hotelContactLevel: hotelContactLevelEl.value,
          hotelRhythm: hotelRhythmEl.value,
          hotelCadre: (hotelCadreEl.value || "").trim(),
          slug,
          link
        };

        const wa = waUrl(WA_DIGIY, buildMessage(data));
        data.wa = wa;
        last = data;

        outBox.classList.remove("hidden");
        slugOut.textContent = slug;
        linkOut.textContent = link;
        btnCopy.href = link;
        btnWhatsApp.href = wa;
        setEnabled(btnCopy, true);
        setEnabled(btnWhatsApp, true);

        try{ localStorage.setItem(LS_KEY, JSON.stringify(data)); }catch(e){}

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: "digiy_jobs_pro_mission_created",
          secteur: currentSecteur,
          missionName,
          mainMetier,
          zone,
          startDate,
          priority,
          countNeeded
        });
      });

      btnCopy.addEventListener("click", async function(e){
        e.preventDefault();
        if(!last || !last.link) return;
        try{
          await navigator.clipboard.writeText(last.link);
          alert("Lien copié ✅");
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: "digiy_jobs_pro_mission_link_copied", slug: last.slug });
        } catch(err){
          prompt("Copie le lien :", last.link);
        }
      });

      setEnabled(btnCopy, false);
      setEnabled(btnWhatsApp, false);
    })();
  </script>
</body>
</html>
